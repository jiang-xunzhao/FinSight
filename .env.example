DEEPSEEK_API_KEY=replace-with-your-key
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-password
MYSQL_DATABASE=finance_report
# 只读账号默认**留空**。坑（实测踩过）：这两行原来写着 finsight_reader 这种明文示例值，
# 照着 example 抄一份 .env 就带上服务器了 ⇒ data.py 的 query_all() 见 MYSQL_READONLY_USER
# 非空就把**所有读查询**换成那个账号 ⇒ 机器上从没建过它 ⇒ 每个读库接口 1045 Access denied
# ⇒ 首页一打开就是「服务内部错误」。要真用只读账号，先按 create_readonly_user.sql.example
# 在 MySQL 里建出来，再填这两行。
MYSQL_READONLY_USER=
MYSQL_READONLY_PASSWORD=
HF_ENDPOINT=https://hf-mirror.com
QDRANT_URL=
VECTOR_BACKEND=qdrant
# 监听地址：留空 = 只听 127.0.0.1（只有这台机器能打开）。要让别的电脑访问（部署到服务器）
# 就填 0.0.0.0，同时必须自己配好这台机器的防火墙和云安全组（登录闸门见下）。
APP_HOST=

# 登录闸门：两行**都**非空才启用（全站要登录，30 天免登录 cookie）。
# 任一行留空 = 全站照旧开放、谁都能访问——对上公网时务必填上。
LOGIN_USER=replace-with-your-username
LOGIN_PASSWORD=replace-with-a-strong-password
